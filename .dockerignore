# Never put personal documents, local work, or generated corpus fixtures in the build context.
/*.docx
/*.xlsx
/*.pptx
/*.pdf
/*.doc
/*.odt
# Test documents in vendored submodules are not needed by the runtime either.
**/*.docx
**/*.xlsx
**/*.pptx
**/*.pdf
**/*.doc
**/*.odt
*.cleaned.*
/samples/
/work/
/reports/
/tests/corpus/generated/

# Local environments, caches, compiled binaries, and repository/agent metadata.
/.venv/
/.cache/
/bin/
/.git/
**/.git
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
/third_party/subtext-scan/node_modules/
/odd/
/.atl/
