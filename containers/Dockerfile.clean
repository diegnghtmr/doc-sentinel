# doc-sentinel clean image: watermarks-remover Layer A + metadata + C2PA inspection.
#   docker build -f containers/Dockerfile.clean -t doc-sentinel-clean .
# Layer B (paraphrase / humanize) is never installed nor invoked.

ARG PYTHON_VERSION=3.12
ARG RUST_VERSION=1.88

# Optional c2patool (inspection only; it has no --remove). Pin with --build-arg C2PATOOL_VERSION=x.y.z
FROM rust:${RUST_VERSION}-slim-bookworm AS c2patool
ARG C2PATOOL_VERSION=
RUN mkdir -p /out && if [ -n "$C2PATOOL_VERSION" ]; then \
      apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev \
      && cargo install c2patool --locked --version "$C2PATOOL_VERSION" \
      && cp /usr/local/cargo/bin/c2patool /out/; fi

FROM python:${PYTHON_VERSION}-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 DOC_SENTINEL_HOME=/opt/doc-sentinel
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libimage-exiftool-perl qpdf util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=c2patool /out/ /usr/local/bin/
WORKDIR /opt/doc-sentinel
COPY . .
RUN pip install -e .
RUN useradd --create-home sentinel
USER sentinel
WORKDIR /work
ENTRYPOINT ["doc-sentinel"]
CMD ["--help"]
